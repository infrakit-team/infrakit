{
	"name": "@infrakit-team/module-kv-postgres",
	"version": "0.1.16",
	"private": false,
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run build:js && bun run build:types",
		"build:js": "bun build index.ts --outdir ./dist --target=node",
		"build:types": "bunx tsc --project tsconfig.build.json",
		"prepublishOnly": "bun run build",
		"test": "pglite-server --run \"bun test\" --include-database-url"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./migration": "./migration.ts"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.3.11",
		"@electric-sql/pglite-socket": "^0.0.16",
		"@infrakit-team/module-kv": "workspace:*",
		"consola": "^3.4.2",
		"kysely": "^0.28.8",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/pg": "^8.15.6"
	}
}
